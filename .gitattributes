# Normalise line endings in the repo (LF) regardless of the OS editing it,
# so Windows checkouts and Linux CI/deploy builds don't churn the diff.
* text=auto eol=lf

# Binary site assets — never diff or convert these.
*.pdf  binary
*.mp4  binary
*.webm binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
